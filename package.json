{
  "name": "payloadops",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel --filter @payloadops/api --filter @payloadops/web run dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "seed:queries": "pnpm --filter @payloadops/seed run seed:queries"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
